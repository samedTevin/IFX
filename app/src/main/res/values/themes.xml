<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 12+ System Splash Screen Theme (Cold App Launch).
        Displays the official App Icon badge (the black squircle with the IFX logo from Image 3).
        This clearly distinguishes the cold start from the subsequent Compose animated wordmark.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color: #FFFFFF (light) / #0A0A0A (dark from values-night) -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Official App Icon squircle badge displayed during cold start -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_cold_app_badge</item>

        <!-- Application theme applied once the splash screen completes -->
        <item name="postSplashScreenTheme">@style/Theme.IFX</item>
    </style>

    <!-- Backward-compatible alias for Theme.MySplashScreen -->
    <style name="Theme.MySplashScreen" parent="Theme.App.Starting" />

    <!-- Main application theme -->
    <style name="Theme.IFX" parent="android:Theme.Material.Light.NoActionBar" />

</resources>
